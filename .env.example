# ---------------------------------------------------------------------------
# Aegis · environment
# Copy to `.env.local` (Next.js) and `contracts/.env` (Hardhat)
# ---------------------------------------------------------------------------

# Deployed AegisCallZK address on Monad Testnet (chainId 10143)
NEXT_PUBLIC_AEGIS_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: override the Monad Testnet RPC (defaults to https://rpc.testnet.monad.xyz)
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.testnet.monad.xyz

# ---------------------------------------------------------------------------
# Deployer key — ONLY used by Hardhat, never exposed to the browser.
# Fund it on the Monad Testnet faucet: https://faucet.monad.xyz
# ---------------------------------------------------------------------------
# MONAD_TESTNET_PRIVATE_KEY=0x...
# MONAD_TESTNET_RPC_URL=https://rpc.testnet.monad.xyz
# MONADSCAN_API_KEY=
